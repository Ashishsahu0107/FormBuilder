generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  FORM_BUILDER
  APPROVER
  VIEWER
}

enum FormStatus {
  DRAFT
  UNDER_REVIEW
  APPROVED
  PUBLISHED
  ACTIVE
  DEACTIVATED
  ARCHIVED
}

enum VersionStatus {
  DRAFT
  UNDER_REVIEW
  APPROVED
  PUBLISHED
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(FORM_BUILDER)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  forms         Form[]
  versions      FormVersion[]
  approvals     FormApproval[]
  templates     Template[]

  @@map("users")
}

model Form {
  id               String     @id @default(cuid())
  title            String
  slug             String     @unique
  description      String?
  category         String?
  tags             String[]   @default([])
  views            Int        @default(0)
  status           FormStatus @default(DRAFT)
  currentVersionId String?
  deletedAt        DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  createdBy   String
  user        User          @relation(fields: [createdBy], references: [id])
  versions    FormVersion[]
  approvals   FormApproval[]

  @@map("forms")
}

model FormVersion {
  id            String        @id @default(cuid())
  formId        String
  versionNumber Int
  schema        Json
  status        VersionStatus @default(DRAFT)
  publishedAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  createdBy  String
  approvedBy String?
  creator    User   @relation(fields: [createdBy], references: [id])
  form       Form   @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@unique([formId, versionNumber])
  @@map("form_versions")
}

model FormApproval {
  id        String   @id @default(cuid())
  formId    String
  versionId String
  action    String
  comment   String?
  createdAt DateTime @default(now())

  by   String
  user User   @relation(fields: [by], references: [id])
  form Form   @relation(fields: [formId], references: [id])

  @@map("form_approvals")
}

model Template {
  id          String   @id @default(cuid())
  title       String
  description String?
  category    String
  thumbnail   String?
  schema      Json
  isPublic    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy String
  user      User   @relation(fields: [createdBy], references: [id])

  @@map("templates")
}