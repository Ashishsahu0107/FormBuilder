# MongoDB Atlas connection (Required)
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.mongodb.net/formbuilder?retryWrites=true&w=majority"

# Server
PORT=5000
NODE_ENV=production

# JWT (Required)
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Client URL (for CORS) - Set this to Vercel URL
CLIENT_URL=https://form-builder-eosin.vercel.app